# ==========================================
# File Organizer - Security-Hardened .gitignore
# ==========================================

# --- Environment & Secret Configuration ---
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# --- Credentials, Keys & Certificates ---
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.csr
*.pub
id_rsa
id_ed25519
secrets/
credentials.json
client_secret*.json
token.json
service_account*.json
*.keystore

# --- Logs, Audits & Local History Databases ---
logs/
*.log
*.log.*
history.json
*.sqlite
*.sqlite3
*.db
*.rdb

# --- Python Cache & Bytecode ---
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class
*.pyd
*.so

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
bin/
lib/
include/

# --- Testing, Coverage & Type Checkers ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# --- IDE & Editor Specific ---
.vscode/
!.vscode/settings.json.example
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# --- OS-Specific Junk & Metadata ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- Temporary, Backup & Swap Files ---
*.tmp
*.temp
*.bak
*.old
*.orig
*~
*.swp
*.swo
*.lock

# --- Packaging & Distribution ---
build/
dist/
*.egg-info/
*.egg
wheels/
*.tar.gz
