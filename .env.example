# ==============================================================================
# Tideway - Example Environment Configuration Template
# Copy this file to '.env' and adjust your settings.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=production

# Server Network Binding
# Local development: 127.0.0.1 (binds exclusively to localhost for security)
# Cloud / Production hosting: 0.0.0.0 (or leave default if platform injects PORT)
APP_HOST=127.0.0.1
APP_PORT=8000

# Cryptographically Secure Secret Key (REQUIRED in production)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string

# CORS Security (Comma-separated list of allowed origins)
# For production, replace with your live domain: e.g. https://tideway.onrender.com,https://yourdomain.com
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Watchdog File System Daemon Settings
WATCHDOG_DEBOUNCE_SECONDS=2.0

# Logging & Audit Configuration
LOG_LEVEL=INFO
MAX_LOG_FILES=50

# UI Preferences
AUTO_OPEN_BROWSER=true

