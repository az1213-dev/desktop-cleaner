# ==============================================================================
# ClutterCtrl - Example Environment Configuration Template
# Optional: Copy this file to '.env' and adjust custom paths/settings.
# ==============================================================================

# Custom Log Directory (Default: inside clutterctrl/logs/)
# CLUTTERCTRL_LOG_DIR=

# Watchdog Daemon Debounce Seconds (Default: 2.0)
WATCHDOG_DEBOUNCE_SECONDS=2.0

# Max Log Files to Retain (Default: 100)
MAX_LOG_FILES=100

# Console Logging Level (INFO, DEBUG, WARNING, ERROR)
LOG_LEVEL=INFO
